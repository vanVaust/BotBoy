# BotBoy v0.6.0-dev — Environment Configuration
# Copy this file to .env and fill in your values.
# All settings can also be provided via config.yaml.

# ── Core ──────────────────────────────────────────────────────────────────────
BOTBOY_CONFIG=~/.botboy/config.yaml
BOTBOY_DEBUG=false
BOTBOY_LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# JWT secret: MUST be at least 32 characters, cryptographically random
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
BOTBOY_JWT_SECRET=change_me_use_at_least_32_random_characters_here

# Security level: BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
BOTBOY_SECURITY_LEVEL=BEGINNER

# ── LLM Backends ──────────────────────────────────────────────────────────────
# Enable LLM integration
BOTBOY_LLM_ENABLED=false

# Backend: mock | ollama | openai | anthropic
BOTBOY_LLM_BACKEND=mock
BOTBOY_LLM_MODEL=llama3.2

# Ollama (local, no API key required)
OLLAMA_URL=http://localhost:11434

# OpenAI
OPENAI_API_KEY=change_me_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=change_me_anthropic_api_key

# ── AI Engine toggles ─────────────────────────────────────────────────────────
BOTBOY_REFLECTION_ENABLED=false
BOTBOY_PLANNING_ENABLED=false
BOTBOY_PARALLEL_THINK_ENABLED=false

# ── Memory ────────────────────────────────────────────────────────────────────
# simple | hybrid
BOTBOY_MEMORY_ENGINE=simple
BOTBOY_MEMORY_DB=~/.botboy/botboy.db

# ── HTTP Server ───────────────────────────────────────────────────────────────
BOTBOY_HOST=127.0.0.1
BOTBOY_PORT=8765

# ── Prometheus / Grafana (when using docker-compose) ─────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
