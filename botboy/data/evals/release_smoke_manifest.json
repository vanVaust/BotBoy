{
  "name": "release_smoke",
  "wave": "release",
  "cases": [
    {
      "id": "release_status_smoke",
      "kind": "command",
      "command": "status",
      "expected_contains": [
        "BotBoy v0.6.0-dev",
        "Status"
      ],
      "expected": {
        "result_success": true,
        "field_values": {
          "type": "status"
        }
      }
    },
    {
      "id": "release_skills_smoke",
      "kind": "command",
      "command": "skills",
      "expected_contains": [
        "Skills:",
        "botboy-cloud-topology-planner"
      ],
      "expected": {
        "result_success": true,
        "field_values": {
          "type": "skills"
        }
      }
    },
    {
      "id": "release_help_smoke",
      "kind": "command",
      "command": "help",
      "expected_contains": [
        "Available Commands",
        "MEMORY"
      ],
      "expected": {
        "result_success": true,
        "field_values": {
          "type": "help"
        }
      }
    },
    {
      "id": "release_http_status_smoke",
      "kind": "http",
      "request": "GET /api/status",
      "expected_contains": [
        "Status",
        "Trace"
      ],
      "expected": {
        "result_success": true,
        "field_values": {
          "status": 200
        }
      }
    }
  ]
}
